<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>KeepCachedVersions</AssemblyName>
    <RootNamespace>KeepCachedVersions</RootNamespace>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <!-- 游戏 interop 程序集很大且签名不完整，关闭无关告警 -->
    <NoWarn>$(NoWarn);CS0436;CS0618</NoWarn>
  </PropertyGroup>

  <!--
    引用根目录。默认指向 Lethe 分发包（与本机实际运行环境一致）；
    想改指游戏本体目录就传 -p:RefDir=<路径>（例：
    -p:RefDir="C:\Program Files (x86)\Steam\steamapps\common\Limbus Company\BepInEx"）。
  -->
  <PropertyGroup>
    <RefDir Condition="'$(RefDir)' == ''">E:\desktop\work\LimbusDecompile\LetheLauncher-Distribution-7\BepInEx</RefDir>
    <RefCore>$(RefDir)\core</RefCore>
    <RefInterop>$(RefDir)\interop</RefInterop>
  </PropertyGroup>

  <!--
    v0.3.0 起本插件只做"阻止删除"（3 个 Harmony no-op 前缀），不含任何 UI。
    因此引用集收缩到最小：BepInEx + HarmonyX + UnityEngine.CoreModule（Caching 所在模块）。

    刻意 **不引用**：
      - Assembly-CSharp / Il2CppInterop.Runtime / Unity.TextMeshPro / UnityEngine.UI /
        UIModule / TextRenderingModule / InputLegacyModule —— UI 相关全部移除；
      - UnityEngine.IMGUIModule —— 本作 IL2CPP 把 IMGUI 原生实现整段剥掉了，
        运行期必抛 NotSupportedException: Method unstripping failed（v0.2.0 的教训，
        详见 docs/KeepCachedVersions-IMGUI-STRIPPED-FIX-PLAN.md）。
    AddressableManager 通过运行时反射查找，编译期不依赖游戏类型。
  -->
  <ItemGroup>
    <!-- BepInEx 6.0.0 + HarmonyX -->
    <Reference Include="BepInEx.Core">
      <HintPath>$(RefCore)\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(RefCore)\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(RefCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(RefInterop)\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RefInterop)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
